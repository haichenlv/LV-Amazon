{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazon-apparel-listing-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/downloads/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amazon-apparel-listing",
      "database_id": "6b44b6c7-c631-4162-9992-eeb1e6c18c65",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "0902c206f25c4269b04ee9d2bbadf5b1"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://amazon-apparel-listing-cloud.haichenlv-amazon.workers.dev"
  }
}
